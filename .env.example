# AgentVista 复现实验配置；首次配置时复制为 .env，再填写密钥。
# 加载方式：uv run --env-file .env python ...
# 当前自建模型服务无需鉴权，EMPTY 是占位值；启用鉴权后填实际密钥。

# 执行模型：必须是完整的 chat completions URL。
REASONING_MODEL_NAME=Qwen3.8-Flash-Next
REASONING_API_KEY=EMPTY
REASONING_END_POINT=http://172.25.11.251:30001/v1/chat/completions

# 经验与技能模型。
EXPERIENCE_MODEL_NAME=Qwen3.8-Flash-Next
EXPERIENCE_API_KEY=EMPTY
EXPERIENCE_END_POINT=http://172.25.11.251:30001/v1/chat/completions

# 评分模型：使用 /v1 base URL。
VERIFIER_MODEL_NAME=Qwen3.8-Flash-Next
VERIFIER_API_KEY=EMPTY
VERIFIER_END_POINT=http://172.25.11.251:30001/v1

# Embedding 服务：使用 /v1 base URL。
EXPERIENCE_EMBEDDING_MODEL=Qwen3-Embedding-4B
EXPERIENCE_EMBEDDING_API_KEY=EMPTY
EXPERIENCE_EMBEDDING_ENDPOINT=http://127.0.0.1:8001/v1

ENABLE_FUNCTION_CALLING=true
ENABLED_TOOLS=web_search,image_search,visit,code_interpreter

# 必填：Serper.dev 密钥，用于网页搜索、文字搜图与反向搜图。
# 获取：https://serper.dev/ （不是 serpapi.com）
SERPAPI_KEY=

# 建议填写：ImgBB 密钥，用于反向搜图前的图片上传。
# 获取：https://api.imgbb.com/；留空时代码会尝试其他图床。
IMGBB_API_KEY=

# 可选：Jina Reader 密钥。使用时取消注释并填入非空值。
# 不用时保留注释，不能设置为空字符串。
# 获取：https://jina.ai/reader/
# JINA_API_KEY=


# 当前方案不使用备用端点，未配置 *_API_KEY_2 / *_END_POINT_2。
